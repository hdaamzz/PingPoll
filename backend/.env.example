PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/pingpoll
JWT_SECRET=replace-with-a-long-random-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Required by Firebase Admin; use your service-account values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
